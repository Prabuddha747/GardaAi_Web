# ───────── Chatbot (server-side only — NEVER prefix with VITE_) ─────────
# Set in Vercel > Project > Settings > Environment Variables. Local: `vercel dev` reads .env.local
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ───────── Video slots (public, safe in the browser) ─────────
# Naming: VITE_VIDEO_<PAGE>_<N>. Value = YouTube link, YouTube id, or any embed URL (e.g. Bunny).
# Leave a line out/empty to use the built-in default (src/data/videos.ts). Redeploy after changing.

# Home page
# HOME_1 = hero "Why You Choose GardaAI?" popup
# HOME_2..4 = "Hear It From Our Learners" cards (left → right)
VITE_VIDEO_HOME_1=
VITE_VIDEO_HOME_2=
VITE_VIDEO_HOME_3=
VITE_VIDEO_HOME_4=

# About page — hero story video
VITE_VIDEO_ABOUT_1=

# Impact page — "Unki awaaz mein" video
VITE_VIDEO_IMPACT_1=

# Learn page — YouTube only. Empty slot = card hidden. Optional _TITLE overrides the card title.
VITE_VIDEO_LEARN_1=
VITE_VIDEO_LEARN_1_TITLE=
VITE_VIDEO_LEARN_2=
VITE_VIDEO_LEARN_2_TITLE=
VITE_VIDEO_LEARN_3=
VITE_VIDEO_LEARN_3_TITLE=
VITE_VIDEO_LEARN_4=
VITE_VIDEO_LEARN_4_TITLE=
VITE_VIDEO_LEARN_5=
VITE_VIDEO_LEARN_5_TITLE=
VITE_VIDEO_LEARN_6=
VITE_VIDEO_LEARN_6_TITLE=

# ───────── AI Updates page (server-side only — NEVER prefix with VITE_) ─────────
# freenewsapi.io key. Read by api/news.ts (also accepts the lowercase `newsapi_key`). Free plan: 5,000 req/day, ~3 req/s.
NEWS_API_KEY=
